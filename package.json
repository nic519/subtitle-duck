{
  "name": "subtitle-duck",
  "version": "1.0.2",
  "description": "独立字幕桌面工具",
  "type": "module",
  "scripts": {
    "dev": "bun run prepare:native-file-drop && bun scripts/dev-desktop.ts",
    "prepare:native-file-drop": "bun scripts/build-native-file-drop-bridge.ts",
    "build:renderer": "tsc && vite build",
    "build": "bun run build:renderer && bun run prepare:native-file-drop && electrobun build",
    "build:release": "bun run build:renderer && bun run prepare:native-file-drop && electrobun build --env=stable",
    "package": "bun run build:release && bun scripts/package-desktop.ts stable",
    "verify": "bun scripts/verify-local-app.ts",
    "test": "bun test"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electrobun": "^1.18.1",
    "google-translate-api-x": "10.7.3",
    "lucide-react": "^1.17.0",
    "radix-ui": "^1.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shadcn": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.0",
    "vite": "^4.4.5"
  }
}
